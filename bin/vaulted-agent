#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# vaulted-agent — run an AI coding agent as a dedicated service account with
# vault-resolved secrets injected into its process environment at launch.
#
# Properties this is built to hold:
#   * resolved secrets are never written to disk
#   * resolved secrets never appear on argv, so `ps` shows nothing
#   * each harness receives only the secrets its own manifest names
#   * the vault token that unlocks everything is dropped before the agent runs
#   * injection failure aborts the launch; the agent never starts half-fed
#
# Ways to invoke it:
#
#   vaulted-agent codex [args...]     harness as the first argument
#   va codex [args...]                short alias (same binary)
#   codex-conductor [args...]         harness from a per-harness symlink
#   vaulted-agent pick [args...]      interactive harness chooser
#   vaulted-agent run -m MANIFEST -- cmd [args...]
#   vaulted-agent doctor|secrets|version|setup|auth-mode|uninstall
#
# The symlink form lets a sudoers rule name one path per harness, with no
# argument matching. Prefer it when different people are entitled to different
# harnesses. See "Harness selection" and the README.
# ---------------------------------------------------------------------------
set -euo pipefail

# ===== CONFIG ==============================================================
# Bumped on each release tag (vX.Y.Z). install-remote.sh pins the same series.
VERSION="0.3.0"

SERVICE_USER="agent"                        # dedicated, non-human service account
WORKDIR="/srv/agent"                        # agent's working directory
CONFIG_DIR="/etc/vaulted-agent"
HARNESS_DIR="${CONFIG_DIR}/harnesses.d"     # one <name>.conf per harness
MANIFEST_DIR="${CONFIG_DIR}/manifests"      # per-harness secret manifests
LAUNCHER_BIN_DIR="/usr/local/bin"           # where this file and its symlinks live

# Secret backend. Set per harness with `backend =`; this is the default.
# install.sh rewrites this from --backend when present.
#   onepassword  1Password CLI, `op inject` over a file of op:// references
#   bitwarden    Bitwarden Secrets Manager, `bws secret get` per reference
#   sops         a sops-encrypted dotenv, decrypted at launch
#   pass         the passwordstore.org store, `pass show` per reference
#   plainfile    a root-owned KEY=VALUE file. Least protection; see README.
DEFAULT_BACKEND="onepassword"

# Credentials that unlock each backend, all 0640 root:agent. Only the one
# belonging to the selected backend is ever read, and it is dropped from the
# environment before the agent starts.
OP_ENV_FILE="${CONFIG_DIR}/op.env"          # OP_SERVICE_ACCOUNT_TOKEN
BWS_ENV_FILE="${CONFIG_DIR}/bws.env"        # BWS_ACCESS_TOKEN
AGE_KEY_FILE="${CONFIG_DIR}/age.key"        # age identity for sops
DEFAULTS_FILE="${CONFIG_DIR}/defaults.conf" # machine-wide defaults (auth_mode, …)
LAUNCHER_NAME="vaulted-agent"
SHORT_NAME="va"                             # optional short alias installed as a symlink
LINK_SUFFIX="-conductor"                    # claude-conductor -> harness "claude"
LABEL_NAMESPACE="vaulted-agent"              # UUIDv5 namespace for session labels

# Default auth mode when defaults.conf is absent.
#   file    read vault token from op.env / bws.env on disk
#   prompt  ask for the token on each launch (never written by the launcher)
DEFAULT_AUTH_MODE="file"

# Everything not named here, and not named by the harness's manifest or its
# keep= setting, is removed from the environment before the agent starts.
# Keep this list as short as the agent will tolerate.
PASSTHROUGH_VARS=(HOME PATH USER LOGNAME SHELL TERM COLORTERM TZ LANG LC_ALL)
# ===========================================================================

die() { printf '%s: %s\n' "${0##*/}" "$*" >&2; exit 1; }

# Read auth_mode from defaults.conf. Sets AUTH_MODE to file|prompt.
read_auth_mode() {
  local raw entry key val
  AUTH_MODE="$DEFAULT_AUTH_MODE"
  [[ -r "$DEFAULTS_FILE" ]] || return 0
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    raw="${raw%$'\r'}"
    entry="$(trim "$raw")"
    [[ -z "$entry" || "$entry" == "#"* || "$entry" != *=* ]] && continue
    key="$(trim "${entry%%=*}")"
    val="$(trim "${entry#*=}")"
    if [[ "$key" == "auth_mode" ]]; then
      case "$val" in
        file|prompt) AUTH_MODE="$val" ;;
      esac
    fi
  done < "$DEFAULTS_FILE"
}

# Write defaults.conf (auth_mode only for now). Direct write when possible;
# otherwise sudo (typical for /etc/vaulted-agent owned by root).
write_auth_mode() {
  local mode="$1" path="$DEFAULTS_FILE" tmp parent
  case "$mode" in file|prompt) ;; *) die "auth-mode must be 'file' or 'prompt'" ;; esac
  parent="$(dirname -- "$path")"
  tmp="$(mktemp)" || die "mktemp failed"
  cat > "$tmp" <<EOF
# Machine-wide launcher defaults.
# Change later: vaulted-agent auth-mode  |  va auth-mode prompt|file
auth_mode = $mode
EOF
  if [[ -w "$path" ]] || { [[ ! -e "$path" && -w "$parent" ]]; }; then
    install -m 0644 "$tmp" "$path" || { rm -f "$tmp"; die "could not write $path"; }
  elif [[ "$(id -u)" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
    sudo install -m 0644 "$tmp" "$path" || { rm -f "$tmp"; die "could not write $path"; }
  else
    rm -f "$tmp"
    die "writing $path needs root (re-run: sudo $LAUNCHER_NAME auth-mode $mode)"
  fi
  rm -f "$tmp"
  AUTH_MODE="$mode"
  printf 'auth_mode set to %s  (%s)\n' "$mode" "$path"
}

# Strip leading and trailing whitespace. Pure parameter expansion.
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# UUID (any version) for bitwarden refs and session labels.
uuid_re='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
is_uuid() { [[ "$1" =~ $uuid_re ]]; }

# True when a bitwarden manifest ref is a placeholder / not ready to resolve.
is_placeholder_ref() {
  local r="$1" low
  low="$(printf '%s' "$r" | tr '[:upper:]' '[:lower:]')"
  case "$low" in
    ''|replace*|change_me*|changeme*|your_*|todo*|xxx*|example*|placeholder*) return 0 ;;
  esac
  # all-zero UUID variants
  case "$low" in
    *00000000-0000-0000-0000-000000000000*) return 0 ;;
    *replace_with*) return 0 ;;
  esac
  return 1
}

# Resolve manifest path: absolute stays; relative is under MANIFEST_DIR.
resolve_manifest_path() {
  local m="$1"
  [[ "$m" == /* ]] || m="${MANIFEST_DIR}/${m}"
  printf '%s' "$m"
}

# Syntax-check a manifest for a backend. Does not fetch secrets.
# $1=path $2=backend  → prints issues to stderr; returns non-zero if any.
validate_manifest_syntax() {
  local path="$1" backend="$2" raw var ref issues=0 lineno=0
  [[ -r "$path" ]] || { printf 'cannot read manifest %s\n' "$path" >&2; return 1; }
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    lineno=$(( lineno + 1 ))
    raw="$(trim "${raw%$'\r'}")"
    [[ -z "$raw" || "$raw" == "#"* ]] && continue
    if [[ "$raw" != *=* ]]; then
      printf '%s:%d: expected VAR=reference (got %s)\n' "$path" "$lineno" "$raw" >&2
      issues=$(( issues + 1 ))
      continue
    fi
    var="$(trim "${raw%%=*}")"; ref="$(trim "${raw#*=}")"
    if [[ ! "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      printf '%s:%d: bad variable name %s\n' "$path" "$lineno" "$var" >&2
      issues=$(( issues + 1 ))
    fi
    if [[ -z "$ref" ]]; then
      printf '%s:%d: empty reference for %s\n' "$path" "$lineno" "$var" >&2
      issues=$(( issues + 1 ))
      continue
    fi
    case "$backend" in
      bitwarden)
        if is_placeholder_ref "$ref"; then
          printf '%s:%d: %s still has placeholder ref %s\n' "$path" "$lineno" "$var" "$ref" >&2
          issues=$(( issues + 1 ))
          continue
        fi
        # Accept UUID, uuid:UUID, name:NAME, project:PROJ/NAME
        case "$ref" in
          uuid:*)
            if ! is_uuid "${ref#uuid:}"; then
              printf '%s:%d: %s uuid: value is not a UUID: %s\n' "$path" "$lineno" "$var" "$ref" >&2
              issues=$(( issues + 1 ))
            fi ;;
          name:*)
            [[ -n "${ref#name:}" ]] || {
              printf '%s:%d: %s empty name: ref\n' "$path" "$lineno" "$var" >&2
              issues=$(( issues + 1 ))
            } ;;
          project:*)
            if [[ "$ref" != project:*/* || "$ref" == project:/* || "$ref" == project:*/ ]]; then
              printf '%s:%d: %s want project:PROJECT/SECRET (got %s)\n' \
                "$path" "$lineno" "$var" "$ref" >&2
              issues=$(( issues + 1 ))
            fi ;;
          *)
            if ! is_uuid "$ref"; then
              printf '%s:%d: %s bad bitwarden ref %s\n' "$path" "$lineno" "$var" "$ref" >&2
              printf '  use UUID, uuid:UUID, name:NAME, or project:PROJECT/SECRET\n' >&2
              issues=$(( issues + 1 ))
            fi ;;
        esac
        ;;
      onepassword)
        case "$ref" in
          op://*) ;;
          *)
            if is_placeholder_ref "$ref"; then
              printf '%s:%d: %s still has placeholder ref %s\n' "$path" "$lineno" "$var" "$ref" >&2
              issues=$(( issues + 1 ))
            fi ;;
        esac
        ;;
      pass)
        if is_placeholder_ref "$ref"; then
          printf '%s:%d: %s still has placeholder ref %s\n' "$path" "$lineno" "$var" "$ref" >&2
          issues=$(( issues + 1 ))
        fi
        ;;
      plainfile|sops)
        if is_placeholder_ref "$ref" && [[ "$ref" == *REPLACE* || "$ref" == *CHANGE_ME* ]]; then
          printf '%s:%d: %s looks like a placeholder value\n' "$path" "$lineno" "$var" >&2
          issues=$(( issues + 1 ))
        fi
        ;;
    esac
  done < "$path"
  (( issues == 0 ))
}

# List VAR names (not values) from a KEY=VALUE or KEY=ref manifest.
manifest_var_names() {
  local path="$1" raw var
  [[ -r "$path" ]] || return 0
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    raw="$(trim "${raw%$'\r'}")"
    [[ -z "$raw" || "$raw" == "#"* || "$raw" != *=* ]] && continue
    var="$(trim "${raw%%=*}")"
    [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && printf '%s\n' "$var"
  done < "$path"
}

invoked="${0##*/}"
orig=( ${1+"$@"} )               # exact argv, replayed verbatim across the sudo hop
# Directory the human was in when they typed `va …`. Survives the sudo hop via
# VAULTED_AGENT_CALLER_CWD so harnesses can use `workdir = caller` (needed for
# cwd-scoped agent sessions / --resume).
CALLER_CWD="${VAULTED_AGENT_CALLER_CWD:-$PWD}"

# Primary entrypoints (full name and short alias). Not harness-conductor links.
is_primary_cmd() {
  [[ "$1" == "$LAUNCHER_NAME" || "$1" == "$SHORT_NAME" ]]
}

do_version() {
  printf 'vaulted-agent %s\n' "$VERSION"
}

# Read the harness names, plus a one-line summary of each, out of harnesses.d.
# Fills the parallel arrays HNAMES / HCMDS / HMANIFESTS.
read_harnesses() {
  local f
  HNAMES=(); HCMDS=(); HMANIFESTS=()
  compgen -G "$HARNESS_DIR/*.conf" >/dev/null 2>&1 || return 1
  for f in "$HARNESS_DIR"/*.conf; do
    local n="${f##*/}"; n="${n%.conf}"
    HNAMES+=("$n")
    HCMDS+=("$(sed -n 's/^[[:space:]]*command[[:space:]]*=[[:space:]]*//p' "$f" 2>/dev/null | head -1)")
    HMANIFESTS+=("$(sed -n 's/^[[:space:]]*manifest[[:space:]]*=[[:space:]]*//p' "$f" 2>/dev/null | head -1)")
  done
}

# Interactive chooser for `vaulted-agent pick`. Prompts on stderr and reads
# from /dev/tty, so it still works when stdout is being captured. Sets PICKED.
pick_harness() {
  local i choice
  read_harnesses || die "no harnesses configured in $HARNESS_DIR"
  [[ -t 1 && -r /dev/tty ]] || \
    die "'pick' needs an interactive terminal; name the harness instead"
  {
    printf '\n'
    for i in "${!HNAMES[@]}"; do
      printf '  %2d) %-16s %-38s %s\n' \
        "$(( i + 1 ))" "${HNAMES[i]}" "${HCMDS[i]}" "${HMANIFESTS[i]}"
    done
    printf '\n'
  } >&2
  while :; do
    printf 'harness [1-%d, q to quit]: ' "${#HNAMES[@]}" >&2
    read -r choice < /dev/tty || { printf '\n' >&2; exit 130; }
    case "$choice" in
      q|Q|quit|exit) printf 'Nothing launched.\n' >&2; exit 0 ;;
      ''|*[!0-9]*)   printf '  not a number\n' >&2; continue ;;
    esac
    if (( choice >= 1 && choice <= ${#HNAMES[@]} )); then
      PICKED="${HNAMES[choice-1]}"; return 0
    fi
    printf '  out of range\n' >&2
  done
}

usage() {
  local f name cmdline
  read_auth_mode 2>/dev/null || true
  printf 'usage: %s <harness> [args...]\n' "$LAUNCHER_NAME" >&2
  printf '       %s <harness> [args...]             short alias\n' "$SHORT_NAME" >&2
  printf '       %s|%s run -m MANIFEST [--backend NAME] -- cmd [args...]\n' \
    "$LAUNCHER_NAME" "$SHORT_NAME" >&2
  printf '       %s|%s pick [args...]    choose one interactively\n' "$LAUNCHER_NAME" "$SHORT_NAME" >&2
  printf '       %s|%s doctor            check install / harnesses / manifests\n' "$LAUNCHER_NAME" "$SHORT_NAME" >&2
  printf '       %s|%s secrets …         list / get / which / validate / refresh\n' \
    "$LAUNCHER_NAME" "$SHORT_NAME" >&2
  printf '       %s|%s setup             configure vault backend / token\n' "$LAUNCHER_NAME" "$SHORT_NAME" >&2
  printf '       %s|%s refresh [file]    rebuild Bitwarden refs after adding SM secrets\n' \
    "$LAUNCHER_NAME" "$SHORT_NAME" >&2
  printf '       %s|%s auth-mode [mode]  show or set default auth mode\n' "$LAUNCHER_NAME" "$SHORT_NAME" >&2
  printf '       %s|%s version           print version (%s)\n' "$LAUNCHER_NAME" "$SHORT_NAME" "$VERSION" >&2
  printf '       %s|%s uninstall [opts]  remove this install (needs root)\n' "$LAUNCHER_NAME" "$SHORT_NAME" >&2
  printf '       <harness>%s [args...]\n\n' "$LINK_SUFFIX" >&2
  printf 'launcher flags:  --prompt-auth|-p   prompt for vault token this launch (not written to disk)\n' >&2
  printf 'default auth_mode: %s  (file = token on disk; prompt = paste each launch)\n' \
    "${AUTH_MODE:-$DEFAULT_AUTH_MODE}" >&2
  printf 'default backend:   %s\n' "$DEFAULT_BACKEND" >&2
  printf 'uninstall options: --purge  --dry-run  -y|--yes  --link-user NAME\n\n' >&2
  printf 'harnesses in %s:\n' "$HARNESS_DIR" >&2
  if compgen -G "$HARNESS_DIR/*.conf" >/dev/null 2>&1; then
    for f in "$HARNESS_DIR"/*.conf; do
      name="${f##*/}"; name="${name%.conf}"
      cmdline="$(sed -n 's/^[[:space:]]*command[[:space:]]*=[[:space:]]*//p' "$f" 2>/dev/null | head -1)"
      printf '  %-16s %s\n' "$name" "$cmdline" >&2
    done
  else
    printf '  (none configured; copy a .conf.example and drop the suffix)\n' >&2
  fi
}

# Portable helpers (also used by install.sh). Stock macOS has no getent /
# mapfile; prefer tools that exist on both platforms.
user_home() {
  local u="$1" h=""
  if command -v getent >/dev/null 2>&1; then
    h="$(getent passwd "$u" 2>/dev/null | cut -d: -f6 || true)"
    if [[ -n "$h" ]]; then printf '%s\n' "$h"; return 0; fi
  fi
  if command -v python3 >/dev/null 2>&1; then
    h="$(python3 -c 'import pwd,sys; print(pwd.getpwnam(sys.argv[1]).pw_dir)' "$u" 2>/dev/null || true)"
    if [[ -n "$h" ]]; then printf '%s\n' "$h"; return 0; fi
  fi
  if command -v dscl >/dev/null 2>&1; then
    h="$(dscl . -read "/Users/$u" NFSHomeDirectory 2>/dev/null | awk '{print $2}' || true)"
    if [[ -n "$h" ]]; then printf '%s\n' "$h"; return 0; fi
  fi
  h="$(eval printf '%s' "~$u" 2>/dev/null || true)"
  if [[ -n "$h" && "$h" != "~$u" ]]; then printf '%s\n' "$h"; return 0; fi
  return 1
}

resolve_path() {
  local p="$1"
  if command -v realpath >/dev/null 2>&1; then
    realpath "$p" 2>/dev/null || true
    return 0
  fi
  if readlink -f "$p" >/dev/null 2>&1; then
    readlink -f "$p" 2>/dev/null || true
    return 0
  fi
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$p" 2>/dev/null || true
    return 0
  fi
  if [[ -L "$p" ]]; then readlink "$p" 2>/dev/null || true
  else printf '%s\n' "$p"
  fi
}

# Remove what install.sh put on this host. Lives in the installed binary so a
# curl|bash user can run `sudo vaulted-agent uninstall` without the repo tree.
# Same rules as install.sh --uninstall: only remove symlinks that resolve to
# our launcher; keep config unless --purge; never touch backend credentials.
do_uninstall() {
  local PREFIX="$LAUNCHER_BIN_DIR"
  local CONFIG="$CONFIG_DIR"
  local launcher="$PREFIX/$LAUNCHER_NAME"
  local LINK_USER="" PURGE=0 DRY=0 ASSUME_YES=0
  local interactive=0 targets foreign seen_users uh ul t f n_conf n_man
  local ans yn

  while (( $# )); do
    case "$1" in
      --purge)      PURGE=1; shift ;;
      --dry-run)    DRY=1; shift ;;
      -y|--yes)     ASSUME_YES=1; shift ;;
      --link-user)  LINK_USER="${2:?--link-user needs a name}"; shift 2 ;;
      -h|--help)
        printf 'usage: %s uninstall [--purge] [--dry-run] [-y|--yes] [--link-user NAME]\n' "$LAUNCHER_NAME"
        printf '\nRemoves the launcher, our *-conductor symlinks, and the sudoers rule.\n'
        printf 'Keeps config unless --purge. Never removes op.env / backend credentials.\n'
        exit 0
        ;;
      *) die "uninstall: unknown option '$1' (try --help)" ;;
    esac
  done

  if (( ! ASSUME_YES )) && (( ! DRY )) && [[ -t 1 && -r /dev/tty ]]; then interactive=1; fi

  targets=(); foreign=(); seen_users=" "

  # Collect a path if it is ours (symlink to launcher), or note it as foreign.
  consider() {
    local p="$1"
    if [[ -L "$p" && "$(resolve_path "$p")" == "$launcher" ]]; then
      targets+=("$p")
    elif [[ -e "$p" || -L "$p" ]]; then
      foreign+=("$p")
    fi
  }

  shopt -s nullglob
  for f in "$PREFIX"/*-conductor; do
    consider "$f"
  done
  shopt -u nullglob

  # Short alias next to the launcher (default install creates this).
  consider "$PREFIX/$SHORT_NAME"

  for u in ${LINK_USER:+"$LINK_USER"} ${SUDO_USER:+"$SUDO_USER"}; do
    if [[ "$seen_users" == *" $u "* ]]; then continue; fi
    seen_users="$seen_users$u "
    uh="$(user_home "$u" 2>/dev/null || true)"
    if [[ -z "$uh" ]]; then continue; fi
    consider "$uh/.local/bin/vaulted-agent"
    consider "$uh/.local/bin/$SHORT_NAME"
  done

  if [[ -e "$launcher" ]]; then targets+=("$launcher"); fi
  if [[ -e /etc/sudoers.d/vaulted-agent ]]; then targets+=(/etc/sudoers.d/vaulted-agent); fi

  n_conf=0; n_man=0
  if [[ -d "$CONFIG" ]]; then
    shopt -s nullglob
    _c=( "$CONFIG"/harnesses.d/*.conf ); n_conf=${#_c[@]}
    _m=( "$CONFIG"/manifests/*        ); n_man=${#_m[@]}
    shopt -u nullglob
  fi

  printf 'vaulted-agent uninstall\n\n'
  if (( ${#targets[@]} == 0 )) && [[ ! -d "$CONFIG" ]]; then
    printf 'Nothing to remove: no launcher at %s and no config at %s.\n' "$PREFIX" "$CONFIG"
    exit 0
  fi

  printf 'Found:\n'
  for t in ${targets[@]+"${targets[@]}"}; do printf '  %s\n' "$t"; done
  if [[ -d "$CONFIG" ]]; then
    printf '  %s  (%d live harnesses, %d manifests)\n' "$CONFIG" "$n_conf" "$n_man"
  fi
  for f in ${foreign[@]+"${foreign[@]}"}; do printf '  %s  (not ours, will be left alone)\n' "$f"; done

  if (( interactive )) && (( PURGE )); then
    printf '\n--purge given: %s will be removed too.\n' "$CONFIG"
  elif (( interactive )); then
    printf '\n  1) Remove the launcher, its symlinks and the sudoers rule; keep config\n'
    if [[ -d "$CONFIG" ]]; then
      printf '  2) Remove all of that, and %s as well\n' "$CONFIG"
    fi
    printf '  3) Show what would happen, change nothing\n'
    printf '  q) Quit\n\n'
    while :; do
      printf 'choice [1-3, q]: '
      read -r ans < /dev/tty || { printf '\n'; exit 130; }
      case "$ans" in
        1)     break ;;
        2)     if [[ -d "$CONFIG" ]]; then PURGE=1; break; fi; printf '  no config directory to remove\n' ;;
        3)     DRY=1; break ;;
        q|Q)   printf 'Nothing removed.\n'; exit 0 ;;
        *)     printf '  enter 1, 2, 3 or q\n' ;;
      esac
    done
  fi

  if (( PURGE )) && [[ -d "$CONFIG" ]]; then targets+=("$CONFIG"); fi

  if (( interactive )) && (( ! DRY )); then
    printf '\nAbout to remove:\n'
    for t in ${targets[@]+"${targets[@]}"}; do printf '  %s\n' "$t"; done
    printf '\nProceed? [y/N]: '
    read -r yn < /dev/tty || { printf '\n'; exit 130; }
    case "$yn" in
      y|Y|yes|YES) ;;
      *) printf 'Nothing removed.\n'; exit 0 ;;
    esac
  fi

  printf '\n'
  for t in ${targets[@]+"${targets[@]}"}; do
    if (( DRY )); then printf 'would remove %s\n' "$t"
    else rm -rf "$t"; printf 'removed %s\n' "$t"; fi
  done
  for f in ${foreign[@]+"${foreign[@]}"}; do printf 'left alone %s (not ours)\n' "$f"; done

  if (( ! PURGE )) && [[ -d "$CONFIG" ]]; then
    printf '\nkept %s. Add --purge, or choose 2 interactively, to remove it too.\n' "$CONFIG"
  fi
  printf '\nNot touched: any backend credential (op.env / bws.env / age.key).\n'
  printf '  Those are often shared with other tooling; remove by hand if you want them gone.\n'
  exit 0
}

# Show current auth_mode and optionally set it. Reserved unless auth-mode.conf exists.
do_auth_mode() {
  local mode="${1-}" choice
  read_auth_mode
  case "$mode" in
    -h|--help)
      printf 'usage: %s auth-mode [file|prompt|show]\n' "$LAUNCHER_NAME"
      printf '  file    store vault token on disk (op.env / bws.env); no prompt each launch\n'
      printf '  prompt  paste vault token at each launch; nothing written by the launcher\n'
      printf '  show    print the current mode (default with no args in non-TTY)\n'
      printf '\nCurrent: %s  (%s)\n' "$AUTH_MODE" \
        "$( [[ -r "$DEFAULTS_FILE" ]] && printf '%s' "$DEFAULTS_FILE" || printf 'built-in default' )"
      printf 'Per-launch override: -p / --prompt-auth\n'
      return 0
      ;;
    show|'')
      if [[ -z "$mode" && -t 1 && -r /dev/tty ]]; then
        printf 'vaulted-agent auth-mode\n\n'
        printf 'Current default: %s\n' "$AUTH_MODE"
        if [[ -r "$DEFAULTS_FILE" ]]; then
          printf '  from %s\n' "$DEFAULTS_FILE"
        else
          printf '  (no %s yet; using built-in default)\n' "$DEFAULTS_FILE"
        fi
        printf '\nHow should vault tokens be supplied at launch?\n'
        printf '  1) file    — token file on disk (op.env / bws.env)\n'
        printf '  2) prompt  — paste token each launch (nothing on disk)\n'
        printf '  q) quit without changing\n\n'
        printf 'choice [1-2, q]: '
        read -r choice < /dev/tty || exit 130
        case "$choice" in
          1|file)   write_auth_mode file ;;
          2|prompt) write_auth_mode prompt ;;
          q|Q|'')   printf 'Nothing changed (still %s).\n' "$AUTH_MODE" ;;
          *)        die "unknown choice '$choice' (want file, prompt, or q)" ;;
        esac
      else
        printf 'auth_mode=%s\n' "$AUTH_MODE"
      fi
      return 0
      ;;
    file|prompt)
      write_auth_mode "$mode"
      return 0
      ;;
    *)
      die "unknown auth-mode '$mode' (want file, prompt, or show)"
      ;;
  esac
}

# Write a vault token file as 0640 root:SERVICE_USER (uses sudo when needed).
write_backend_token_file() {
  local path="$1" var="$2" token="$3"
  if [[ "$(id -u)" -ne 0 ]]; then
    printf '%s=%s\n' "$var" "$token" | sudo tee "$path" >/dev/null
    sudo chmod 0640 "$path"
    sudo chown "root:${SERVICE_USER}" "$path" 2>/dev/null || true
  else
    printf '%s=%s\n' "$var" "$token" > "$path"
    chmod 0640 "$path"
    chown "root:${SERVICE_USER}" "$path" 2>/dev/null || true
  fi
  printf 'wrote %s\n' "$path"
}

# Prompt text for vault tokens (Bitwarden SM is often confused with vault password).
auth_prompt_label() {
  case "$1" in
    BWS_ACCESS_TOKEN)
      printf 'Bitwarden Secrets Manager access token (Machine Accounts → Access Tokens; not your vault password)'
      ;;
    OP_SERVICE_ACCOUNT_TOKEN)
      printf '1Password service-account token (OP_SERVICE_ACCOUNT_TOKEN)'
      ;;
    *) printf '%s' "$1" ;;
  esac
}

# Ensure BWS_ACCESS_TOKEN is available (env, bws.env, or TTY prompt).
# $1 = write_file|no_write  — write bws.env when auth_mode=file and write_file.
ensure_bws_token() {
  local mode="${1:-no_write}" token path="$BWS_ENV_FILE"
  read_auth_mode 2>/dev/null || true
  if [[ -z "${BWS_ACCESS_TOKEN-}" ]]; then
    if [[ -r "$path" ]] && [[ "$AUTH_MODE" != prompt ]] && (( ! PROMPT_AUTH )); then
      set -a
      # shellcheck source=/dev/null
      . "$path"
      set +a
    fi
  fi
  if [[ -z "${BWS_ACCESS_TOKEN-}" ]]; then
    printf '%s\n(hidden, not echoed): ' "$(auth_prompt_label BWS_ACCESS_TOKEN)"
    [[ -r /dev/tty ]] || die "need a terminal for BWS_ACCESS_TOKEN (or export it / write $path)"
    read -rs token < /dev/tty || token=""
    printf '\n'
    [[ -n "$token" ]] || die "empty token"
    export BWS_ACCESS_TOKEN="$token"
  else
    printf 'Using BWS_ACCESS_TOKEN already available.\n'
  fi
  if [[ "$mode" == write_file && "$AUTH_MODE" == file ]]; then
    write_backend_token_file "$path" BWS_ACCESS_TOKEN "$BWS_ACCESS_TOKEN"
  elif [[ "$mode" == write_file && "$AUTH_MODE" == prompt ]]; then
    printf 'auth_mode=prompt — token not written to disk (good).\n'
    printf '  To store it: %s auth-mode file, then re-run setup/refresh.\n' "$LAUNCHER_NAME"
  fi
  command -v bws >/dev/null 2>&1 || die "bws not on PATH (install Bitwarden Secrets Manager CLI)"
  command -v python3 >/dev/null 2>&1 || die "python3 required to parse bws JSON"
}

# List SM secrets into parallel arrays BWS_IDS / BWS_KEYS / BWS_PROJS.
# Returns 1 if the list is empty.
bws_load_secret_list() {
  local json id key proj
  BWS_IDS=(); BWS_KEYS=(); BWS_PROJS=()
  if ! json="$(bws secret list --output json 2>/dev/null)"; then
    die "bws secret list failed — is BWS_ACCESS_TOKEN a Secrets Manager access token?
  Prefer: $LAUNCHER_NAME secrets list"
  fi
  while IFS=$'\t' read -r id key proj; do
    [[ -n "$id" ]] || continue
    BWS_IDS+=("$id"); BWS_KEYS+=("$key"); BWS_PROJS+=("$proj")
  done < <(printf '%s' "$json" | python3 -c '
import json,sys
try:
    data=json.load(sys.stdin)
except Exception:
    sys.exit(0)
if isinstance(data, dict):
    data=data.get("data") or data.get("secrets") or []
for s in data or []:
    i=s.get("id") or ""
    k=s.get("key") or s.get("name") or ""
    p=(s.get("project") or {})
    if isinstance(p, dict):
        pn=p.get("name") or ""
    else:
        pn=str(p or "")
    print(i+"\t"+k+"\t"+pn)
')
  (( ${#BWS_IDS[@]} > 0 ))
}

bws_print_secret_list() {
  local n
  printf '\nSecrets visible to this token:\n'
  for n in "${!BWS_IDS[@]}"; do
    printf '  %2d) %-36s  %s%s\n' "$(( n + 1 ))" "${BWS_IDS[n]}" "${BWS_KEYS[n]}" \
      "$( [[ -n "${BWS_PROJS[n]}" ]] && printf '  (project: %s)' "${BWS_PROJS[n]}" )"
  done
}

# Map SM secret key → shell VAR name.
bws_key_to_var() {
  local key="$1" line
  line="$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')"
  [[ "$line" =~ ^[A-Z_] ]] || line="SECRET_$line"
  printf '%s' "$line"
}

# One refs line for SM list index n (0-based).
bws_refs_line_for_index() {
  local n="$1" line
  if [[ "${BWS_KEYS[n]}" =~ ^[A-Za-z0-9_./-]+$ && -n "${BWS_KEYS[n]}" ]]; then
    line="$(bws_key_to_var "${BWS_KEYS[n]}")"
    printf '%s=name:%s\n' "$line" "${BWS_KEYS[n]}"
  else
    printf 'SECRET_%d=%s\n' "$(( n + 1 ))" "${BWS_IDS[n]}"
  fi
}

# True if existing refs text already maps this SM secret (by uuid or name:KEY).
bws_refs_text_has_secret() {
  local text="$1" n="$2" id key
  id="${BWS_IDS[n]}"; key="${BWS_KEYS[n]}"
  printf '%s\n' "$text" | grep -Eq "(^|=)(uuid:)?${id}([[:space:]]|$)" && return 0
  if [[ -n "$key" ]]; then
    printf '%s\n' "$text" | grep -Fq "name:${key}" && return 0
    printf '%s\n' "$text" | grep -Eq "project:[^/]+/${key}([[:space:]]|$)" && return 0
  fi
  return 1
}

# Emit selected refs lines to stdout (no header). choice = all | comma indices.
bws_emit_selection_lines() {
  local choice="$1" n num
  if [[ "$choice" == "all" ]]; then
    for n in "${!BWS_IDS[@]}"; do bws_refs_line_for_index "$n"; done
    return 0
  fi
  _old_ifs="$IFS"
  IFS=','
  for num in $choice; do
    num="$(trim "$num")"
    [[ "$num" =~ ^[0-9]+$ ]] || continue
    n=$(( num - 1 ))
    (( n >= 0 && n < ${#BWS_IDS[@]} )) || continue
    bws_refs_line_for_index "$n"
  done
  IFS="$_old_ifs"
  unset _old_ifs num
}

# Install body (with header) to man_path as 0644 (sudo if needed).
bws_install_refs_body() {
  local man_path="$1" body="$2" source="${3:-vaulted-agent}" tmp
  tmp="$(mktemp)" || die "mktemp failed"
  {
    printf '# Bitwarden Secrets Manager refs (no secret values). Generated by %s.\n' "$source"
    printf '# Forms: UUID | uuid:UUID | name:KEY | project:PROJECT/KEY\n'
    printf '# Update after adding secrets in SM: vaulted-agent refresh [file]\n'
    printf '# Values are always fetched live at launch - this file is references only.\n\n'
    printf '%s' "$body"
    [[ "$body" == *$'\n' || -z "$body" ]] || printf '\n'
  } > "$tmp"
  if [[ "$(id -u)" -ne 0 ]]; then
    sudo install -m 0644 "$tmp" "$man_path"
  else
    install -m 0644 "$tmp" "$man_path"
  fi
  rm -f "$tmp"
}

# Write a refs file from selection (full replace).
# $1=path  $2=selection ("all" or comma-separated 1-based indices)
# $3=source label for header comment (setup|refresh)
bws_write_refs_file() {
  local man_path="$1" choice="$2" source="${3:-vaulted-agent}" body
  body="$(bws_emit_selection_lines "$choice")"
  bws_install_refs_body "$man_path" "$body" "$source"
  printf '\nWrote refs file (references only, no secret values):\n  %s\n' "$man_path"
  printf 'Point a harness at it with:\n  backend  = bitwarden\n  manifest = %s\n' "${man_path##*/}"
  printf 'Or one-shot:\n  %s run -m %s --backend bitwarden -- your-command\n' \
    "$LAUNCHER_NAME" "${man_path##*/}"
  printf 'After adding more secrets in Bitwarden SM:\n  %s refresh %s\n' \
    "$LAUNCHER_NAME" "${man_path##*/}"
}

# Merge selection into an existing refs file: keep prior lines, append new.
# Selection indices are into BWS_IDS (full list). Skips secrets already present.
bws_merge_refs_file() {
  local man_path="$1" choice="$2" source="${3:-vaulted-agent refresh}" 
  local existing body new_lines n num line added=0
  existing=""
  [[ -r "$man_path" ]] && existing="$(cat -- "$man_path")"

  new_lines=""
  if [[ "$choice" == "all" ]]; then
    for n in "${!BWS_IDS[@]}"; do
      if bws_refs_text_has_secret "$existing" "$n"; then continue; fi
      line="$(bws_refs_line_for_index "$n")"
      new_lines+="$line"
      added=$(( added + 1 ))
    done
  else
    _old_ifs="$IFS"
    IFS=','
    for num in $choice; do
      num="$(trim "$num")"
      [[ "$num" =~ ^[0-9]+$ ]] || continue
      n=$(( num - 1 ))
      (( n >= 0 && n < ${#BWS_IDS[@]} )) || continue
      if bws_refs_text_has_secret "$existing" "$n"; then
        printf '  skip (already mapped): %s\n' "${BWS_KEYS[n]:-${BWS_IDS[n]}}"
        continue
      fi
      line="$(bws_refs_line_for_index "$n")"
      new_lines+="$line"
      added=$(( added + 1 ))
    done
    IFS="$_old_ifs"
    unset _old_ifs num
  fi

  if (( added == 0 )); then
    printf '\nNo new secrets to add — %s already has every selected mapping.\n' "$man_path"
    return 0
  fi

  if [[ -n "$existing" ]]; then
    body="${existing}"$'\n'$'\n'"# --- appended by ${source} ---"$'\n'"${new_lines}"
  else
    body="$new_lines"
  fi
  bws_install_refs_body "$man_path" "$body" "$source"
  printf '\nUpdated refs file (+%d mapping(s)), references only:\n  %s\n' "$added" "$man_path"
  printf 'New lines:\n'
  printf '%s' "$new_lines" | sed 's/^/  /'
  printf 'After adding more secrets in Bitwarden SM:\n  %s refresh %s\n' \
    "$LAUNCHER_NAME" "${man_path##*/}"
}

# Interactive Bitwarden: token → optional secret pick → refs manifest.
setup_bitwarden_guided() {
  local man_path choice
  printf '\nBitwarden Secrets Manager\n'
  printf '  Needs a Machine Account access token (BWS_ACCESS_TOKEN),\n'
  printf '  not your personal vault master password or login API key.\n\n'
  ensure_bws_token write_file
  if ! bws_load_secret_list; then
    printf 'No secrets in this machine account yet. Create one in the SM UI, then:\n'
    printf '  %s secrets list\n' "$LAUNCHER_NAME"
    printf '  %s refresh\n' "$LAUNCHER_NAME"
    return 0
  fi
  bws_print_secret_list
  printf '\nWrite a refs file from these secrets?\n'
  printf '  A refs file maps env var names to Bitwarden secret references only\n'
  printf '  (e.g. OPENAI_API_KEY=name:openai-api-key). It never stores secret values\n'
  printf '  or your access token. Harnesses point at it with: manifest = <filename>\n'
  printf 'Build refs file? [y/N]: '
  read -r choice < /dev/tty || choice=""
  case "$choice" in y|Y|yes|YES) ;; *) printf 'Skipped refs-file builder.\n'; return 0 ;; esac
  printf '\nFilename for that refs file (under %s).\n' "$MANIFEST_DIR"
  printf '  Examples: openai.env.refs  (for image tools),  agent.env.refs  (for coding agents).\n'
  printf '  Press Enter for the default, or type a name / absolute path.\n'
  printf 'Refs filename [%s]: ' "openai.env.refs"
  read -r man_path < /dev/tty || man_path=""
  man_path="$(trim "${man_path:-openai.env.refs}")"
  [[ "$man_path" == /* ]] || man_path="${MANIFEST_DIR}/${man_path}"
  printf '\nWhich secrets from the list above go into that file?\n'
  printf '  Enter numbers from the list (comma-separated), or "all".\n'
  printf '  Each becomes one VAR=name:… (or UUID) line in the refs file.\n'
  printf 'Secrets to include [all]: '
  read -r choice < /dev/tty || choice=""
  choice="$(trim "${choice:-all}")"
  bws_write_refs_file "$man_path" "$choice" "vaulted-agent setup"
}

# Same refs-file builder as setup, for after setup — update an existing file.
# Values are always fetched live at launch; this only updates *references*.
#
#   va refresh                         # interactive (merge into existing by default)
#   va refresh openai.env.refs         # that file
#   va refresh openai.env.refs --all   # merge every not-yet-mapped secret
#   va refresh openai.env.refs --replace --all   # rewrite file from scratch
#   va secrets refresh …
do_refresh() {
  local man_path="" take_all=0 mode="" choice n existing new_count=0
  # mode: merge (default when file exists) | replace
  read_auth_mode 2>/dev/null || true
  while (( $# )); do
    case "$1" in
      -h|--help)
        printf 'usage: %s refresh [manifest] [--all] [--merge|--replace]\n' "$LAUNCHER_NAME"
        printf '\nUpdate a Bitwarden refs file (same process as setup’s refs builder).\n'
        printf 'Secret *values* are never stored — each launch fetches them live.\n'
        printf 'Use this when you *add* secrets in SM and want new VAR=name:… lines.\n\n'
        printf '  %s refresh                         interactive\n' "$LAUNCHER_NAME"
        printf '  %s refresh openai.env.refs         update that file (merge by default)\n' "$LAUNCHER_NAME"
        printf '  %s refresh openai.env.refs --all   append every new SM secret\n' "$LAUNCHER_NAME"
        printf '  %s refresh openai.env.refs --replace --all\n' "$LAUNCHER_NAME"
        printf '      rewrite the file from scratch (like first-time setup)\n'
        printf '  %s secrets refresh …               same command\n' "$LAUNCHER_NAME"
        return 0
        ;;
      --all|-a) take_all=1; shift ;;
      --merge)  mode=merge; shift ;;
      --replace|--rewrite) mode=replace; shift ;;
      -m|--manifest)
        (( $# >= 2 )) || die "refresh: $1 needs a path"
        man_path="$2"; shift 2 ;;
      --manifest=*)
        man_path="${1#*=}"; shift ;;
      -*)
        die "refresh: unknown option '$1' (try --help)" ;;
      *)
        [[ -z "$man_path" ]] || die "refresh: extra argument '$1'"
        man_path="$1"; shift ;;
    esac
  done

  printf 'vaulted-agent refresh\n\n'
  printf 'Same refs-file writer as setup — for after you add secrets in SM.\n'
  printf 'Does not cache secret values — only which secrets a harness may request.\n\n'
  ensure_bws_token no_write
  if ! bws_load_secret_list; then
    printf 'No secrets visible to this token yet.\n'
    return 1
  fi

  if [[ -z "$man_path" ]]; then
    if [[ -r /dev/tty ]]; then
      printf 'Refs file to update (under %s) [openai.env.refs]: ' "$MANIFEST_DIR"
      read -r man_path < /dev/tty || man_path=""
      man_path="$(trim "${man_path:-openai.env.refs}")"
    else
      man_path="openai.env.refs"
    fi
  fi
  [[ "$man_path" == /* ]] || man_path="${MANIFEST_DIR}/${man_path}"

  # Default mode: merge if file exists, else replace (create).
  if [[ -z "$mode" ]]; then
    if [[ -e "$man_path" ]]; then mode=merge; else mode=replace; fi
  fi

  existing=""
  if [[ -r "$man_path" ]]; then
    existing="$(cat -- "$man_path")"
    printf 'File: %s\n' "$man_path"
    printf 'Mode: %s\n' "$mode"
    if [[ "$mode" == merge ]]; then
      printf '\nAlready in file (kept as-is):\n'
      printf '%s\n' "$existing" | while IFS= read -r line || [[ -n "$line" ]]; do
        line="$(trim "${line%$'\r'}")"
        [[ -z "$line" || "$line" == "#"* || "$line" != *=* ]] && continue
        printf '  %s\n' "$line"
      done
      printf '\nNew in Secrets Manager (not yet mapped):\n'
      new_count=0
      for n in "${!BWS_IDS[@]}"; do
        if bws_refs_text_has_secret "$existing" "$n"; then continue; fi
        new_count=$(( new_count + 1 ))
        printf '  %2d) %-36s  %s%s\n' "$(( n + 1 ))" "${BWS_IDS[n]}" "${BWS_KEYS[n]}" \
          "$( [[ -n "${BWS_PROJS[n]}" ]] && printf '  (project: %s)' "${BWS_PROJS[n]}" )"
      done
      if (( new_count == 0 )); then
        printf '  (none — every visible secret is already referenced)\n'
        printf '\nNothing to merge. Use --replace to rebuild the whole file.\n'
        unset BWS_ACCESS_TOKEN
        return 0
      fi
    else
      printf '\nReplace mode: file will be rewritten from your selection.\n'
      bws_print_secret_list
    fi
  else
    mode=replace
    printf 'Creating new file: %s\n' "$man_path"
    bws_print_secret_list
  fi

  if (( take_all )); then
    choice="all"
  elif [[ -r /dev/tty ]]; then
    if [[ "$mode" == merge ]]; then
      printf '\nWhich new secrets to append?\n'
      printf '  Numbers from the list above (comma-separated), or "all".\n'
      printf 'Secrets to add [all]: '
    else
      printf '\nWhich secrets go into the file?\n'
      printf '  Numbers (comma-separated), or "all".\n'
      printf 'Secrets to include [all]: '
    fi
    read -r choice < /dev/tty || choice=""
    choice="$(trim "${choice:-all}")"
  else
    choice="all"
  fi

  if [[ "$mode" == merge ]]; then
    bws_merge_refs_file "$man_path" "$choice" "vaulted-agent refresh"
  else
    if [[ -e "$man_path" && -r /dev/tty ]] && (( ! take_all )); then
      printf '\nReplace entire file? [y/N]: '
      read -r choice_confirm < /dev/tty || choice_confirm=""
      case "$(trim "$choice_confirm")" in
        y|Y|yes|YES) ;;
        *) printf 'Aborted (use default merge mode, or --merge).\n'; unset BWS_ACCESS_TOKEN; return 0 ;;
      esac
    fi
    bws_write_refs_file "$man_path" "$choice" "vaulted-agent refresh"
  fi
  unset BWS_ACCESS_TOKEN
  return 0
}

# Interactive vault token / backend help. Reserved name unless setup.conf exists.
do_setup() {
  local choice token path
  read_auth_mode
  printf 'vaulted-agent setup\n\n'
  printf 'Configure a vault backend credential for this machine.\n'
  printf 'Auto-harnesses start as plainfile+empty.env; change their backend/manifest\n'
  printf 'after this if you want vault injection.\n'
  printf 'Current auth_mode: %s  (change with: vaulted-agent auth-mode)\n\n' "$AUTH_MODE"
  printf '  1) 1Password  (writes op.env with OP_SERVICE_ACCOUNT_TOKEN)\n'
  printf '  2) Bitwarden  (SM access token; optional secret → refs manifest)\n'
  printf '  3) Show pass / sops notes only\n'
  printf '  4) Change default auth mode (file vs prompt)\n'
  printf '  q) Quit\n\n'
  printf 'choice: '
  [[ -r /dev/tty ]] || die "setup needs a terminal"
  read -r choice < /dev/tty || exit 130
  case "$choice" in
    1|onepassword|op)
      path="$OP_ENV_FILE"
      printf '%s\n(hidden, not echoed): ' "$(auth_prompt_label OP_SERVICE_ACCOUNT_TOKEN)"
      read -rs token < /dev/tty || token=""
      printf '\n'
      [[ -n "$token" ]] || die "empty token"
      write_backend_token_file "$path" OP_SERVICE_ACCOUNT_TOKEN "$token"
      printf 'Next: set backend=onepassword and a real manifest on each harness.\n'
      if [[ "$AUTH_MODE" == prompt ]]; then
        printf 'Note: auth_mode is prompt — launches still ask for the token unless you run:\n'
        printf '  %s auth-mode file\n' "$LAUNCHER_NAME"
      fi
      ;;
    2|bitwarden|bws)
      setup_bitwarden_guided
      if [[ "$AUTH_MODE" == prompt ]]; then
        printf 'Note: auth_mode is prompt — each launch asks for the SM access token unless you run:\n'
        printf '  %s auth-mode file\n' "$LAUNCHER_NAME"
      fi
      ;;
    3)
      printf 'pass: service account needs GPG + `pass show`; backend=pass, VAR=store/path\n'
      printf 'sops: age identity at %s (0600); backend=sops, encrypted dotenv manifest\n' \
        "$AGE_KEY_FILE"
      ;;
    4|auth-mode|auth_mode)
      do_auth_mode
      ;;
    q|Q) printf 'Nothing changed.\n' ;;
    *) die "unknown choice" ;;
  esac
}

# Health check: install paths, harnesses, backends, manifest syntax (no secret values).
do_doctor() {
  local f name be man conf cmd_line bin_dir issues=0 warn=0 status
  local workdir_key have_bws=0 have_op=0 have_sops=0 have_pass=0
  read_auth_mode 2>/dev/null || true
  printf 'vaulted-agent doctor  (v%s)\n\n' "$VERSION"
  printf 'Launcher\n'
  printf '  binary       : %s\n' "$(command -v "$LAUNCHER_NAME" 2>/dev/null || printf '%s/%s' "$LAUNCHER_BIN_DIR" "$LAUNCHER_NAME")"
  printf '  version      : %s\n' "$VERSION"
  printf '  service user : %s\n' "$SERVICE_USER"
  printf '  config       : %s\n' "$CONFIG_DIR"
  printf '  default backend : %s\n' "$DEFAULT_BACKEND"
  printf '  auth_mode    : %s' "$AUTH_MODE"
  if [[ -r "$DEFAULTS_FILE" ]]; then printf '  (%s)\n' "$DEFAULTS_FILE"
  else printf '  (built-in default; no %s)\n' "$DEFAULTS_FILE"; fi
  printf '\nBackend CLIs\n'
  if command -v bws >/dev/null 2>&1; then have_bws=1; printf '  bws   : %s\n' "$(command -v bws)"
  else printf '  bws   : missing (needed for backend=bitwarden)\n'; fi
  if command -v op >/dev/null 2>&1; then have_op=1; printf '  op    : %s\n' "$(command -v op)"
  else printf '  op    : missing (needed for backend=onepassword)\n'; fi
  if command -v sops >/dev/null 2>&1; then have_sops=1; printf '  sops  : %s\n' "$(command -v sops)"
  else printf '  sops  : missing (needed for backend=sops)\n'; fi
  if command -v pass >/dev/null 2>&1; then have_pass=1; printf '  pass  : %s\n' "$(command -v pass)"
  else printf '  pass  : missing (needed for backend=pass)\n'; fi
  printf '\nAuth files\n'
  for f in \
    "op.env:$OP_ENV_FILE" \
    "bws.env:$BWS_ENV_FILE" \
    "age.key:$AGE_KEY_FILE"
  do
    name="${f%%:*}"; apath="${f#*:}"
    if [[ -r "$apath" ]]; then
      printf '  %-8s present %s\n' "$name" "$apath"
    else
      printf '  %-8s absent  %s\n' "$name" "$apath"
    fi
  done
  unset apath
  if [[ "$AUTH_MODE" == prompt ]]; then
    printf '  (auth_mode=prompt: token files optional; launches prompt on a TTY)\n'
  fi
  printf '\nHarnesses in %s\n' "$HARNESS_DIR"
  if ! compgen -G "$HARNESS_DIR/*.conf" >/dev/null 2>&1; then
    printf '  (none)\n'
    warn=$(( warn + 1 ))
  fi
  shopt -s nullglob
  for conf in "$HARNESS_DIR"/*.conf; do
    name="${conf##*/}"; name="${name%.conf}"
    be="$(sed -n 's/^[[:space:]]*backend[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
    man="$(sed -n 's/^[[:space:]]*manifest[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
    cmd_line="$(sed -n 's/^[[:space:]]*command[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
    bin_dir="$(sed -n 's/^[[:space:]]*bin[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
    workdir_key="$(sed -n 's/^[[:space:]]*workdir[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
    be="$(trim "${be:-$DEFAULT_BACKEND}")"
    man="$(trim "$man")"
    status="ok"
    printf '  %s\n' "$name"
    printf '    backend=%s  manifest=%s  workdir=%s\n' \
      "$be" "${man:-?}" "${workdir_key:-"(install default)"}"
    if [[ -z "$cmd_line" ]]; then
      printf '    ERROR: no command =\n'; issues=$(( issues + 1 )); status=err
    fi
    if [[ -z "$man" ]]; then
      printf '    ERROR: no manifest =\n'; issues=$(( issues + 1 )); status=err
    else
      man_path="$(resolve_manifest_path "$man")"
      if [[ ! -r "$man_path" ]]; then
        printf '    ERROR: cannot read %s\n' "$man_path"; issues=$(( issues + 1 )); status=err
      elif ! validate_manifest_syntax "$man_path" "$be" 2>/dev/null; then
        printf '    ERROR: manifest syntax problems:\n'
        validate_manifest_syntax "$man_path" "$be" 2>&1 | sed 's/^/      /' || true
        issues=$(( issues + 1 )); status=err
      else
        printf '    manifest syntax ok (%s)\n' "$man_path"
      fi
    fi
    case "$be" in
      bitwarden) (( have_bws )) || { printf '    ERROR: bws not on PATH\n'; issues=$(( issues + 1 )); } ;;
      onepassword) (( have_op )) || { printf '    ERROR: op not on PATH\n'; issues=$(( issues + 1 )); } ;;
      sops) (( have_sops )) || { printf '    ERROR: sops not on PATH\n'; issues=$(( issues + 1 )); } ;;
      pass) (( have_pass )) || { printf '    ERROR: pass not on PATH\n'; issues=$(( issues + 1 )); } ;;
      plainfile) ;;
      *) printf '    ERROR: unknown backend %s\n' "$be"; issues=$(( issues + 1 )) ;;
    esac
    case "$name" in
      claude|codex|grok|kimi)
        if [[ "$workdir_key" != "caller" ]]; then
          printf '    WARN: agent harness without workdir=caller (resume/sessions often need it)\n'
          warn=$(( warn + 1 ))
        fi
        ;;
    esac
    # command first word on PATH if bin set
    if [[ -n "$bin_dir" && -n "$cmd_line" ]]; then
      bin_dir="${bin_dir//\$\{HOME\}/$HOME}"; bin_dir="${bin_dir//\$HOME/$HOME}"
      first="${cmd_line%% *}"
      if [[ "$first" != /* && ! -x "$bin_dir/$first" && ! -x "$(command -v "$first" 2>/dev/null || true)" ]]; then
        if [[ ! -x "$bin_dir/$first" ]]; then
          printf '    WARN: %s not found under bin=%s (may still resolve at launch)\n' "$first" "$bin_dir"
          warn=$(( warn + 1 ))
        fi
      fi
    fi
    unset man_path first
  done
  shopt -u nullglob
  printf '\nSummary: %d error(s), %d warning(s)\n' "$issues" "$warn"
  if (( issues )); then
    printf 'Fix errors before relying on launches. Try: %s setup\n' "$LAUNCHER_NAME"
    return 1
  fi
  printf 'Ready (syntax checks only; live vault access not probed).\n'
  return 0
}

# Load BWS or OP auth for helper subcommands (secrets list/get) without scrubbing.
# Reuses the same prompt/file rules as launch, after read_auth_mode + PROMPT_AUTH.
ensure_helper_auth() {
  local backend="$1"
  case "$backend" in
    bitwarden)
      # Inline minimal load: prefer env, then file, then prompt.
      if [[ -n "${BWS_ACCESS_TOKEN-}" ]]; then return 0; fi
      if (( PROMPT_AUTH )) || [[ ! -r "$BWS_ENV_FILE" ]]; then
        if [[ -r /dev/tty ]]; then
          printf '%s\n(hidden, not written to disk): ' "$(auth_prompt_label BWS_ACCESS_TOKEN)" >/dev/tty
          local token=""
          read -rs token < /dev/tty || token=""
          printf '\n' >/dev/tty
          [[ -n "$token" ]] || die "empty BWS_ACCESS_TOKEN"
          export BWS_ACCESS_TOKEN="$token"
          return 0
        fi
      fi
      if [[ -r "$BWS_ENV_FILE" ]]; then
        set -a
        # shellcheck source=/dev/null
        . "$BWS_ENV_FILE"
        set +a
        [[ -n "${BWS_ACCESS_TOKEN-}" ]] || die "$BWS_ENV_FILE does not define BWS_ACCESS_TOKEN"
        return 0
      fi
      die "need BWS_ACCESS_TOKEN (export it, use -p, or write $BWS_ENV_FILE)"
      ;;
    onepassword)
      if [[ -n "${OP_SERVICE_ACCOUNT_TOKEN-}" ]]; then return 0; fi
      if [[ -r "$OP_ENV_FILE" ]]; then
        set -a
        # shellcheck source=/dev/null
        . "$OP_ENV_FILE"
        set +a
        return 0
      fi
      die "need OP_SERVICE_ACCOUNT_TOKEN or $OP_ENV_FILE"
      ;;
  esac
}

do_secrets() {
  local sub="${1-}" ref man conf be man_path var
  read_auth_mode 2>/dev/null || true
  # Honour -p already folded into PROMPT_AUTH by caller when we are dispatched early.
  case "$sub" in
    -h|--help|help|'')
      printf 'usage: %s secrets list\n' "$LAUNCHER_NAME"
      printf '       %s secrets get <ref>\n' "$LAUNCHER_NAME"
      printf '       %s secrets which\n' "$LAUNCHER_NAME"
      printf '       %s secrets validate [manifest-or-harness]\n' "$LAUNCHER_NAME"
      printf '       %s secrets refresh [manifest] [--all]\n' "$LAUNCHER_NAME"
      printf '\nrefs: UUID | uuid:UUID | name:KEY | project:PROJECT/KEY\n'
      printf 'list/get use Bitwarden Secrets Manager (bws) with the same auth as launches.\n'
      printf 'refresh rebuilds a refs file after you add secrets in SM (alias: %s refresh).\n' \
        "$LAUNCHER_NAME"
      return 0
      ;;
    refresh)
      shift
      do_refresh ${1+"$@"}
      return $?
      ;;
    list)
      ensure_helper_auth bitwarden
      command -v bws >/dev/null 2>&1 || die "bws not on PATH"
      bws secret list --output table 2>/dev/null || bws secret list
      unset BWS_ACCESS_TOKEN
      return 0
      ;;
    get)
      ref="${2-}"
      [[ -n "$ref" ]] || die "usage: $LAUNCHER_NAME secrets get <ref>"
      ensure_helper_auth bitwarden
      command -v bws >/dev/null 2>&1 || die "bws not on PATH"
      # Resolve name: / project: to UUID then get — reuse python list lookup.
      ref="$(bws_resolve_ref_to_id "$ref")" || die "could not resolve ref"
      bws secret get "$ref" --output json \
        | python3 -c 'import json,sys; print(json.load(sys.stdin)["value"])'
      unset BWS_ACCESS_TOKEN
      return 0
      ;;
    which)
      printf 'Harness → variables (names only; values never printed)\n\n'
      shopt -s nullglob
      for conf in "$HARNESS_DIR"/*.conf; do
        name="${conf##*/}"; name="${name%.conf}"
        be="$(sed -n 's/^[[:space:]]*backend[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
        man="$(sed -n 's/^[[:space:]]*manifest[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
        be="$(trim "${be:-$DEFAULT_BACKEND}")"
        man="$(trim "$man")"
        printf '%s  (backend=%s manifest=%s)\n' "$name" "$be" "${man:-?}"
        if [[ -n "$man" ]]; then
          man_path="$(resolve_manifest_path "$man")"
          if [[ -r "$man_path" ]]; then
            while IFS= read -r var; do
              printf '  %s\n' "$var"
            done < <(manifest_var_names "$man_path")
          else
            printf '  (manifest missing: %s)\n' "$man_path"
          fi
        fi
      done
      shopt -u nullglob
      return 0
      ;;
    validate)
      man="${2-}"
      if [[ -z "$man" ]]; then
        # validate every harness manifest
        local err=0
        shopt -s nullglob
        for conf in "$HARNESS_DIR"/*.conf; do
          name="${conf##*/}"; name="${name%.conf}"
          be="$(sed -n 's/^[[:space:]]*backend[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
          man="$(sed -n 's/^[[:space:]]*manifest[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
          be="$(trim "${be:-$DEFAULT_BACKEND}")"
          man_path="$(resolve_manifest_path "$(trim "$man")")"
          printf '%s: ' "$name"
          if validate_manifest_syntax "$man_path" "$be"; then
            printf 'ok\n'
          else
            printf 'FAIL\n'; err=1
          fi
        done
        shopt -u nullglob
        return "$err"
      fi
      # harness name or manifest path
      if [[ -r "$HARNESS_DIR/${man}.conf" ]]; then
        conf="$HARNESS_DIR/${man}.conf"
        be="$(sed -n 's/^[[:space:]]*backend[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
        man="$(sed -n 's/^[[:space:]]*manifest[[:space:]]*=[[:space:]]*//p' "$conf" 2>/dev/null | head -1)"
        be="$(trim "${be:-$DEFAULT_BACKEND}")"
        man_path="$(resolve_manifest_path "$(trim "$man")")"
      else
        man_path="$(resolve_manifest_path "$man")"
        be="${3:-$DEFAULT_BACKEND}"
      fi
      validate_manifest_syntax "$man_path" "$be"
      ;;
    *)
      die "unknown secrets subcommand '$sub' (try: list, get, which, validate)"
      ;;
  esac
}

# Map a bitwarden ref to a secret id (UUID). Needs BWS_ACCESS_TOKEN set.
# Prints the UUID only.
bws_resolve_ref_to_id() {
  local ref="$1" bare
  case "$ref" in
    uuid:*) bare="${ref#uuid:}" ;;
    *) bare="$ref" ;;
  esac
  if is_uuid "$bare"; then
    printf '%s' "$bare"
    return 0
  fi
  case "$ref" in
    name:*|project:*)
      command -v python3 >/dev/null 2>&1 || die "python3 required for name: / project: refs"
      bws secret list --output json | python3 -c '
import json,sys
ref=sys.argv[1]
data=json.load(sys.stdin)
if isinstance(data, dict):
    data=data.get("data") or data.get("secrets") or []
want_name=None
want_proj=None
if ref.startswith("name:"):
    want_name=ref[5:]
elif ref.startswith("project:"):
    rest=ref[8:]
    if "/" not in rest:
        sys.stderr.write("project: ref needs PROJECT/SECRET\n"); sys.exit(2)
    want_proj, want_name=rest.split("/",1)
else:
    sys.stderr.write("bad ref\n"); sys.exit(2)
matches=[]
for s in data or []:
    key=s.get("key") or s.get("name") or ""
    if key != want_name:
        continue
    p=s.get("project") or {}
    pn=p.get("name") if isinstance(p, dict) else str(p or "")
    if want_proj is not None and pn != want_proj:
        continue
    matches.append(s.get("id") or "")
if not matches:
    sys.stderr.write("no secret matched %r\n" % (ref,)); sys.exit(1)
if len(matches) > 1 and want_proj is None:
    sys.stderr.write("multiple secrets named %r; use project:PROJECT/%s\n" % (want_name, want_name)); sys.exit(1)
sys.stdout.write(matches[0])
' "$ref"
      ;;
    *)
      die "bad bitwarden ref '$ref' (UUID, uuid:UUID, name:KEY, or project:PROJECT/KEY)"
      ;;
  esac
}

# --- Reserved: version (no config, no root) --------------------------------
if is_primary_cmd "$invoked" \
   && { [[ "${1-}" == "version" ]] || [[ "${1-}" == "--version" ]] || [[ "${1-}" == "-V" ]]; }; then
  do_version
  exit 0
fi

# --- Reserved: uninstall (must run as root, never as the agent user) --------
if is_primary_cmd "$invoked" \
   && { [[ "${1-}" == "uninstall" ]] || [[ "${1-}" == "--uninstall" ]]; }; then
  shift
  # --help must not require root / sudo password.
  for _ua in ${1+"$@"}; do
    case "$_ua" in -h|--help) do_uninstall --help ;; esac
  done
  unset _ua
  if [[ "$(id -u)" -ne 0 ]]; then
    if command -v sudo >/dev/null 2>&1; then
      # Preserve SUDO_USER so home-link cleanup finds the invoker.
      # Re-exec via the long name so a missing short alias still uninstalls.
      exec sudo env \
        "SUDO_USER=${SUDO_USER:-$(id -un)}" \
        "${LAUNCHER_BIN_DIR}/${LAUNCHER_NAME}" uninstall ${1+"$@"}
    fi
    die "uninstall needs root (re-run: sudo $LAUNCHER_NAME uninstall)"
  fi
  do_uninstall ${1+"$@"}
fi

# --- Pull launcher flags out of the argument list --------------------------
# Everything not consumed here is passed through to the agent untouched.
#
# Auth mode resolution (first match wins for "prompt this launch"):
#   1. -p / --prompt-auth
#   2. VAULTED_AGENT_PROMPT_AUTH=1
#   3. VAULTED_AGENT_AUTH_MODE=prompt|file
#   4. defaults.conf auth_mode (set at install or via `auth-mode`)
#   5. DEFAULT_AUTH_MODE (file)
harness_flag=""
PROMPT_AUTH_FLAG=0
read_auth_mode
case "${VAULTED_AGENT_AUTH_MODE:-}" in
  prompt|file) AUTH_MODE="$VAULTED_AGENT_AUTH_MODE" ;;
esac
[[ "${VAULTED_AGENT_PROMPT_AUTH:-}" == "1" ]] && AUTH_MODE=prompt
args=()
while (( $# )); do
  case "$1" in
    -H|--harness) (( $# >= 2 )) || die "-H requires a value"; harness_flag="$2"; shift 2 ;;
    --harness=*)  harness_flag="${1#*=}"; shift ;;
    -p|--prompt-auth) PROMPT_AUTH_FLAG=1; shift ;;
    --)           args+=("$@"); break ;;
    *)            args+=("$1"); shift ;;
  esac
done
set -- ${args[@]+"${args[@]}"}
(( PROMPT_AUTH_FLAG )) && AUTH_MODE=prompt
PROMPT_AUTH=0
[[ "$AUTH_MODE" == prompt ]] && PROMPT_AUTH=1

# --- Harness selection -----------------------------------------------------
# The re-exec path is rebuilt from a configured directory plus the *invoked*
# name, and is deliberately NOT `readlink -f "$0"`. The reflex to resolve the
# symlink is wrong here: sudoers grants are written per-path, one line per
# harness symlink, and resolving through to vaulted-agent would miss all of them.
if is_primary_cmd "$invoked"; then
  # `vaulted-agent codex ...` or `va codex ...`: first arg is the harness
  # when it is not an option.
  positional=""
  if (( $# )) && [[ "$1" != -* ]]; then positional="$1"; shift; fi
  # Refusing both at once closes the escape that would otherwise defeat a
  # sudoers rule of the form `vaulted-agent codex *`, which would happily
  # match a trailing `-H claude`.
  [[ -z "$positional" || -z "$harness_flag" ]] || \
    die "harness given twice: '$positional' and -H '$harness_flag'"
  HARNESS="${positional:-$harness_flag}"
  [[ -n "$HARNESS" ]] || { usage; exit 1; }
  # `pick` / `uninstall` are reserved unless a harness of that name exists.
  # Choosing resolves to a concrete harness and then rewrites the argument list
  # to the form the user could have typed, so the sudo hop below asks for the
  # chosen harness and the ordinary per-harness sudoers rules still apply.
  if [[ "$HARNESS" == "pick" && ! -e "$HARNESS_DIR/pick.conf" ]]; then
    pick_harness
    HARNESS="$PICKED"
    orig=( "$HARNESS" ${1+"$@"} )
  fi
  if [[ "$HARNESS" == "uninstall" && ! -e "$HARNESS_DIR/uninstall.conf" ]]; then
    die "internal error: uninstall should have been handled earlier"
  fi
  # Reserved management commands (no service-user hop, no agent).
  # A real harness of the same name wins if harnesses.d/<name>.conf exists.
  if [[ "$HARNESS" == "version" || "$HARNESS" == "--version" || "$HARNESS" == "-V" ]] \
     && [[ ! -e "$HARNESS_DIR/version.conf" ]]; then
    do_version
    exit 0
  fi
  if [[ "$HARNESS" == "setup" && ! -e "$HARNESS_DIR/setup.conf" ]]; then
    do_setup
    exit 0
  fi
  if [[ "$HARNESS" == "refresh" && ! -e "$HARNESS_DIR/refresh.conf" ]]; then
    do_refresh ${1+"$@"}
    exit $?
  fi
  if [[ "$HARNESS" == "auth-mode" && ! -e "$HARNESS_DIR/auth-mode.conf" ]]; then
    do_auth_mode ${1+"$@"}
    exit 0
  fi
  if [[ "$HARNESS" == "doctor" && ! -e "$HARNESS_DIR/doctor.conf" ]]; then
    do_doctor
    exit $?
  fi
  if [[ "$HARNESS" == "secrets" && ! -e "$HARNESS_DIR/secrets.conf" ]]; then
    do_secrets ${1+"$@"}
    exit $?
  fi
  # `run` continues into the service-user path (needs scrub + resolve + exec).
  # Keep the invoked name (va or vaulted-agent) so sudoers can grant either path.
  launcher_path="${LAUNCHER_BIN_DIR}/${invoked}"
else
  # A harness symlink was invoked, so the link name decides the harness and
  # -H is refused. Honouring -H here would let a caller who is entitled to a
  # narrow harness borrow a wider harness's manifest just by passing a flag.
  [[ -z "$harness_flag" ]] || die "-H is not accepted when invoked as '$invoked'"
  HARNESS="${invoked%"$LINK_SUFFIX"}"
  [[ "$HARNESS" != "$invoked" ]] || die "symlink '$invoked' does not end in '$LINK_SUFFIX' (and is not '$LAUNCHER_NAME' or '$SHORT_NAME')"
  launcher_path="${LAUNCHER_BIN_DIR}/${invoked}"
fi

# Constrain the name before it is used to build a path.
[[ "$HARNESS" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid harness name '$HARNESS'"

# --- Become the service account --------------------------------------------
# Replay the original argv exactly, so a sudoers rule matches the command line
# as typed. Rewriting `vaulted-agent codex` into `vaulted-agent -H codex` here
# would force every rule to be written in a form the user never types.
# Pass CALLER_CWD so `workdir = caller` still sees the human's directory after
# sudo resets the environment.
if [[ "$(id -un)" != "$SERVICE_USER" ]]; then
  exec sudo -u "$SERVICE_USER" env \
    "VAULTED_AGENT_CALLER_CWD=$CALLER_CWD" \
    "$launcher_path" ${orig[@]+"${orig[@]}"}
fi

# --- Read the harness definition (or parse `run`) --------------------------
# One file per harness, `key = value`, one setting per line. The file is
# parsed, never sourced and never eval'd. Sourcing is less code and is what
# most shell projects reach for, but it makes the config file arbitrary code
# executed as the service account that holds the vault token.
#
# `va run -m MANIFEST [--backend NAME] [--workdir DIR] -- cmd [args…]`
# skips harnesses.d and injects into an arbitrary command (same scrub + resolve).

bin_dir=""; manifest=""; labels="no"; keep_extra=""; backend=""; workdir_key=""
cmd=(); extra_args=()
conf=""
RUN_MODE=0

if [[ "$HARNESS" == "run" && ! -e "$HARNESS_DIR/run.conf" ]]; then
  RUN_MODE=1
  workdir_key="caller"
  backend="$DEFAULT_BACKEND"
  run_manifest=""; run_backend=""; run_workdir=""
  # Parse run flags from remaining argv; command starts after -- (or first non-flag).
  while (( $# )); do
    case "$1" in
      -m|--manifest)
        (( $# >= 2 )) || die "run: $1 needs a manifest path"
        run_manifest="$2"; shift 2 ;;
      --manifest=*)
        run_manifest="${1#*=}"; shift ;;
      --backend)
        (( $# >= 2 )) || die "run: --backend needs a name"
        run_backend="$2"; shift 2 ;;
      --backend=*)
        run_backend="${1#*=}"; shift ;;
      --workdir)
        (( $# >= 2 )) || die "run: --workdir needs a path or 'caller'"
        run_workdir="$2"; shift 2 ;;
      --workdir=*)
        run_workdir="${1#*=}"; shift ;;
      -h|--help)
        printf 'usage: %s run -m MANIFEST [--backend NAME] [--workdir DIR] -- cmd [args...]\n' \
          "$LAUNCHER_NAME"
        printf '\nInject vault-resolved secrets into any command (no harness file).\n'
        printf '  -m, --manifest   refs file (relative paths are under %s)\n' "$MANIFEST_DIR"
        printf '  --backend        onepassword|bitwarden|sops|pass|plainfile (default: %s)\n' \
          "$DEFAULT_BACKEND"
        printf '  --workdir        caller (default) | absolute path | \$HOME/…\n'
        printf '  -p               prompt for vault token this launch\n'
        printf '\nExample:\n'
        printf '  %s run -m openai.env.refs --backend bitwarden -- \\\\\n' "$LAUNCHER_NAME"
        printf '    python gpt_image.py generate "a lighthouse" --output out.png\n'
        exit 0
        ;;
      --)
        shift
        break ;;
      -*)
        die "run: unknown option '$1' (want -m/--manifest, --backend, --workdir, or --)"
        ;;
      *)
        # bare command without -- is allowed: va run -m x env
        break ;;
    esac
  done
  (( $# )) || die "run: missing command after options (try: run -m MANIFEST -- cmd)"
  [[ -n "$run_manifest" ]] || die "run: need -m/--manifest"
  manifest="$run_manifest"
  [[ -n "$run_backend" ]] && backend="$run_backend"
  [[ -n "$run_workdir" ]] && workdir_key="$run_workdir"
  cmd=( "$@" )
  set --
  backend="${backend:-$DEFAULT_BACKEND}"
else
  conf="${HARNESS_DIR}/${HARNESS}.conf"
  [[ -r "$conf" ]] || die "unknown harness '$HARNESS' (no readable $conf)"

  lineno=0
  while IFS= read -r raw || [[ -n "$raw" ]]; do
    lineno=$(( lineno + 1 ))
    raw="${raw%$'\r'}"                                  # tolerate CRLF
    entry="$(trim "$raw")"
    [[ -z "$entry" || "$entry" == "#"* ]] && continue
    [[ "$entry" == *=* ]] || die "$conf:$lineno: expected 'key = value'"
    key="$(trim "${entry%%=*}")"
    val="$(trim "${entry#*=}")"
    case "$key" in
      bin)      bin_dir="$val" ;;
      manifest) manifest="$val" ;;
      labels)   labels="$val" ;;
      keep)     keep_extra="$val" ;;
      backend)  backend="$val" ;;
      workdir)  workdir_key="$val" ;;
      command)
        # Word-split on whitespace only: no globbing, no expansion, no eval.
        # Use `arg =` lines for any argument that contains a space.
        set -f; _oifs="$IFS"; IFS=$' \t'
        # shellcheck disable=SC2206
        cmd=( $val )
        IFS="$_oifs"; set +f; unset _oifs ;;
      arg)      extra_args+=("$val") ;;                 # taken verbatim, spaces and all
      *)        die "$conf:$lineno: unknown key '$key'" ;;
    esac
  done < "$conf"

  (( ${#cmd[@]} )) || die "$conf: no 'command =' line"
  [[ -n "$manifest" ]] || die "$conf: no 'manifest =' line"
  cmd+=( ${extra_args[@]+"${extra_args[@]}"} )
  backend="${backend:-$DEFAULT_BACKEND}"
fi

# Expand $HOME by substitution rather than eval, for the same reason as above.
bin_dir="${bin_dir//\$\{HOME\}/$HOME}"; bin_dir="${bin_dir//\$HOME/$HOME}"
# Also expand $HOME in command[0] when it is a path (tool CLIs under $HOME/…).
if (( ${#cmd[@]} )) && [[ "${cmd[0]}" == *'$HOME'* || "${cmd[0]}" == *'${HOME}'* ]]; then
  cmd[0]="${cmd[0]//\$\{HOME\}/$HOME}"
  cmd[0]="${cmd[0]//\$HOME/$HOME}"
fi
manifest="$(resolve_manifest_path "$manifest")"
[[ -r "$manifest" ]] || die "cannot read manifest $manifest"
# Fail closed on placeholder refs / bad UUIDs before talking to the vault.
if ! validate_manifest_syntax "$manifest" "$backend"; then
  die "manifest validation failed for $manifest (backend=$backend). Fix refs or run: $LAUNCHER_NAME secrets validate"
fi

# Working directory for the agent process.
#   (unset)     → WORKDIR from install (service account home / --workdir)
#   caller      → directory where the user typed `va …` (for --resume / project work)
#   path/$HOME  → absolute or $HOME-relative path
case "$workdir_key" in
  '')
    run_cwd="$WORKDIR" ;;
  caller)
    run_cwd="$CALLER_CWD"
    [[ -n "$run_cwd" ]] || die "$conf: workdir=caller but caller directory is unknown"
    ;;
  *)
    run_cwd="${workdir_key//\$\{HOME\}/$HOME}"
    run_cwd="${run_cwd//\$HOME/$HOME}"
    ;;
esac
cd "$run_cwd" || die "cannot cd to $run_cwd (harness workdir)"

# plainfile never calls load_auth, so auth_mode=prompt / -p would be silent.
# Tell the operator why no token prompt appeared.
if (( PROMPT_AUTH )) && [[ "$backend" == plainfile || "$backend" == sops || "$backend" == pass ]]; then
  if [[ -w /dev/tty ]]; then
    printf 'vaulted-agent: auth_mode=prompt has no vault-token step for backend=%s\n' \
      "$backend" >/dev/tty
    if [[ "$backend" == plainfile ]]; then
      printf '  this harness is still plainfile (day-one empty.env). Wire a vault backend:\n' \
        >/dev/tty
      printf '    edit %s  →  backend = bitwarden|onepassword  + a refs manifest\n' \
        "$conf" >/dev/tty
      printf '    or re-run: sudo ./install.sh   and choose Bitwarden/1Password again\n' \
        >/dev/tty
    fi
  fi
fi

# --- Scrub the inherited environment ---------------------------------------
# Without this the manifest only ever ADDS variables, and every secret already
# in the caller's environment rides along. `sudo` resets the environment on the
# cross-user path, so it is easy to believe this is handled -- but the launcher
# is also run with no sudo hop at all: from cron as the service account, from a
# service-account login shell, and, most importantly here, by one agent
# shelling out to another. In that last case a harness with a deliberately
# narrow manifest would inherit the full set from its parent, and the manifests
# would be describing a boundary that does not exist.
keep=( ${PASSTHROUGH_VARS[@]+"${PASSTHROUGH_VARS[@]}"} )
if [[ -n "$keep_extra" ]]; then
  _oifs="$IFS"; IFS=', '
  # shellcheck disable=SC2206
  keep+=( $keep_extra )
  IFS="$_oifs"; unset _oifs
fi
# names only; no values are copied. Built without mapfile (bash 3.2 / macOS).
exported=()
while IFS= read -r name; do
  [[ -n "$name" ]] && exported+=("$name")
done < <(compgen -e)
for name in ${exported[@]+"${exported[@]}"}; do
  for k in "${keep[@]}"; do
    [[ "$name" == "$k" ]] && continue 2
  done
  unset "$name"
done

# Exported shell FUNCTIONS are not variables and do not appear in `compgen -e`.
# Bash ships them in the environment as BASH_FUNC_<name>%% and rebuilds them in
# the child, so the loop above cannot see them and `unset` would not remove
# them. Left in place, a caller could export a function named `git`, `curl` or
# `ssh` and have the agent call it instead of the real binary.
exported_fns=()
while IFS= read -r name; do
  [[ -n "$name" ]] && exported_fns+=("$name")
done < <(declare -Fx 2>/dev/null | awk '{print $3}')
for name in ${exported_fns[@]+"${exported_fns[@]}"}; do
  for k in "${keep[@]}"; do
    [[ "$name" == "$k" ]] && continue 2
  done
  unset -f "$name" 2>/dev/null || true
done
unset exported exported_fns name k

# --- Resolve the manifest into this process's environment ------------------
# Backends come in two shapes. STREAM backends hand back the whole KEY=VALUE
# document in one call. PER-KEY backends take a manifest of VAR=<reference>
# lines and are asked for one secret at a time; they cost one round trip per
# variable, but a value containing a newline cannot corrupt the next one.

export_line() {
  local l; l="$(trim "$1")"
  [[ -z "$l" || "$l" == "#"* || "$l" != *=* ]] && return 0
  # export, never eval: values legitimately contain $, backticks and quotes.
  # shellcheck disable=SC2163
  export "$l"
}

# Walk resolved text with parameter expansion only. The obvious spelling,
#   while IFS= read -r line; do ...; done <<< "$text"
# is a trap: bash serves a here-string from a pipe only while it fits in the
# pipe buffer, and spills to a /tmp/sh-thd.XXXXXX file above it (64KiB on
# Linux; older bash writes the file unconditionally). That would put every
# resolved secret on disk, silently, the first time a manifest outgrew the
# buffer. This never leaves memory, and runs in the current shell so that the
# exports survive.
export_stream() {
  local text="$1" line
  while [[ -n "$text" ]]; do
    line="${text%%$'\n'*}"
    if [[ "$line" == "$text" ]]; then text=""; else text="${text#*$'\n'}"; fi
    export_line "$line"
  done
}

# Load backend auth from a disk file, or prompt on a TTY when auth_mode=prompt
# (via defaults, -p, or env). Prompted tokens are never written by the launcher.
load_auth() {                                # $1 = file, $2 = variable it must set
  local file="$1" var="$2" token=""
  # Already present in the environment (e.g. caller exported before launch).
  if [[ -n "${!var-}" ]]; then return 0; fi

  if (( PROMPT_AUTH )); then
    [[ -r /dev/tty ]] || die "auth_mode=prompt needs a terminal (or export $var)
  For agent→agent launches: auth-mode file + $file, or export $var in the parent."
    printf '%s\n(not written to disk): ' "$(auth_prompt_label "$var")" >/dev/tty
    read -rs token < /dev/tty || token=""
    printf '\n' >/dev/tty
    [[ -n "$token" ]] || die "empty $var"
    export "$var=$token"
    return 0
  fi

  if [[ -r "$file" ]]; then
    set -a
    # shellcheck source=/dev/null
    . "$file"
    set +a
    [[ -n "${!var-}" ]] || die "$file does not define $var"
    return 0
  fi

  # No file and not forced prompt: offer a one-shot prompt when a TTY is present.
  if [[ -r /dev/tty ]]; then
    printf 'vaulted-agent: %s missing %s\n' "$backend" "$file" >/dev/tty
    printf '  enter %s for this launch only (empty to abort):\n  ' \
      "$(auth_prompt_label "$var")" >/dev/tty
    read -rs token < /dev/tty || token=""
    printf '\n' >/dev/tty
    [[ -n "$token" ]] || die "backend '$backend' needs $file (or: auth-mode prompt / -p / export $var)"
    export "$var=$token"
    return 0
  fi

  die "backend '$backend' needs $file (is this the service account?).
  No TTY for a token prompt. For agent→agent launches either:
    - auth_mode=file + $file (0640), or
    - export $var in the parent before $LAUNCHER_NAME …
  Or run from a terminal: $LAUNCHER_NAME auth-mode prompt / -p"
}

auth_vars=()
case "$backend" in
  onepassword)
    load_auth "$OP_ENV_FILE" OP_SERVICE_ACCOUNT_TOKEN; auth_vars=(OP_SERVICE_ACCOUNT_TOKEN)
    resolved="$(op inject -i "$manifest")" \
      || die "op inject failed for $manifest; refusing to launch"
    export_stream "$resolved"; unset resolved ;;

  sops)
    [[ -r "$AGE_KEY_FILE" ]] || die "backend 'sops' needs $AGE_KEY_FILE"
    export SOPS_AGE_KEY_FILE="$AGE_KEY_FILE"; auth_vars=(SOPS_AGE_KEY_FILE)
    resolved="$(sops --decrypt "$manifest")" \
      || die "sops could not decrypt $manifest; refusing to launch"
    export_stream "$resolved"; unset resolved ;;

  plainfile)
    # The manifest IS the secrets here. Nothing is resolved and nothing is
    # revocable centrally; this exists so the pattern can be demonstrated
    # without an account anywhere. Keep it 0600 root:agent.
    resolved="$(cat -- "$manifest")" || die "cannot read $manifest"
    export_stream "$resolved"; unset resolved ;;

  pass|bitwarden)
    [[ "$backend" != bitwarden ]] || { load_auth "$BWS_ENV_FILE" BWS_ACCESS_TOKEN
                                       auth_vars=(BWS_ACCESS_TOKEN); }
    # bws: fetch then parse. A pipe to python turned auth failures into a
    # confusing JSONDecodeError ("Expecting value") after bws printed the real
    # reason (often: token is not a Secrets Manager access token).
    # Refs: UUID | uuid:UUID | name:KEY | project:PROJECT/KEY
    bws_secret_value() {
      local ref="$1" id errf json val
      id="$(bws_resolve_ref_to_id "$ref")" || die "could not resolve bitwarden ref '$ref'"
      errf="$(mktemp)" || die "mktemp failed"
      if ! json="$(bws secret get "$id" --output json 2>"$errf")"; then
        val="$(tr -d '\r' < "$errf" | head -c 500)"
        rm -f "$errf"
        die "bws secret get '$ref' (id $id) failed${val:+
  $val}
  BWS_ACCESS_TOKEN must be a Bitwarden Secrets Manager access token
  (Machine Accounts → Access Tokens), not your vault password or login API key.
  List secrets: $LAUNCHER_NAME secrets list"
      fi
      rm -f "$errf"
      val="$(printf '%s' "$json" | python3 -c \
        'import json,sys; sys.stdout.write(json.load(sys.stdin)["value"])')" \
        || die "bws secret get '$ref' returned unparseable JSON"
      printf '%s' "$val"
    }
    while IFS= read -r raw || [[ -n "$raw" ]]; do
      raw="$(trim "${raw%$'\r'}")"
      [[ -z "$raw" || "$raw" == "#"* || "$raw" != *=* ]] && continue
      var="$(trim "${raw%%=*}")"; ref="$(trim "${raw#*=}")"
      [[ "$var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "$manifest: bad variable name '$var'"
      if [[ "$backend" == pass ]]; then
        value="$(pass show "$ref")" || die "pass show '$ref' failed; refusing to launch"
        value="${value%%$'\n'*}"             # line 1 is the secret, by convention
      else
        value="$(bws_secret_value "$ref")" || exit 1
      fi
      export "$var=$value"
    done < "$manifest"
    unset raw var ref value
    unset -f bws_secret_value 2>/dev/null || true ;;

  *) die "unknown backend '$backend' (onepassword|bitwarden|sops|pass|plainfile)" ;;
esac

# Drop the backend credential before handing off. Without this the agent
# inherits the key that unlocks the whole store, which would make the
# per-harness manifests decorative -- any harness could read the rest itself.
for v in ${auth_vars[@]+"${auth_vars[@]}"}; do unset "$v"; done
unset auth_vars v

# --- Session resume argv ---------------------------------------------------
# Agents disagree on CLI shape. After the harness name we pass args through,
# with small normalizations so a common `va <agent> resume|‑‑resume <id>`
# habit works across vendors:
#
#   labels=yes           map non-UUID resume targets to a stable UUIDv5
#   codex                native is `resume <id>`; rewrite --resume/-r → resume
#   claude / grok / kimi native is --resume/-r (kimi: --session/-S; --resume
#                        is a documented hidden alias); rewrite bare `resume`
#
# Examples:
#   va claude --resume b03ca221-…-…
#   va claude resume b03ca221-…-…
#   va codex resume 019fabc2-…-…
#   va codex --resume 019fabc2-…-…
#   va grok --resume 019fabc1-…-…
#   va kimi --continue
#   va kimi --session abc123
#   va kimi resume abc123

uuid_re='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
label_to_uuid() {
  python3 -c 'import uuid,sys; print(uuid.uuid5(uuid.NAMESPACE_URL, sys.argv[2]+":"+sys.argv[1]))' \
    "$1" "$LABEL_NAMESPACE"
}

if [[ "$labels" == "yes" ]]; then
  mapped=()
  while (( $# )); do
    case "$1" in
      --session-id|-r|--resume)
        flag="$1"; shift
        if (( $# )) && [[ "$1" != -* ]]; then
          val="$1"; shift
          [[ "$val" =~ $uuid_re ]] || val="$(label_to_uuid "$val")"
          mapped+=("$flag" "$val")
        else
          mapped+=("$flag")
        fi ;;
      --session-id=*|--resume=*)
        flag="${1%%=*}"; val="${1#*=}"; shift
        [[ "$val" =~ $uuid_re ]] || val="$(label_to_uuid "$val")"
        mapped+=("$flag" "$val") ;;
      # Subcommand form: `resume [SESSION_ID]` (codex native; also accepted above)
      resume)
        mapped+=("$1"); shift
        if (( $# )) && [[ "$1" != -* ]]; then
          val="$1"; shift
          [[ "$val" =~ $uuid_re ]] || val="$(label_to_uuid "$val")"
          mapped+=("$val")
        fi ;;
      *) mapped+=("$1"); shift ;;
    esac
  done
  set -- ${mapped[@]+"${mapped[@]}"}
fi

agent_base="${cmd[0]##*/}"
case "$agent_base" in
  codex)
    # Codex speaks `resume`, not `--resume`.
    mapped=()
    while (( $# )); do
      case "$1" in
        --resume|-r)
          shift
          mapped+=(resume)
          if (( $# )) && [[ "$1" != -* ]]; then
            mapped+=("$1"); shift
          fi ;;
        --resume=*)
          mapped+=(resume "${1#*=}"); shift ;;
        *)
          mapped+=("$1"); shift ;;
      esac
    done
    set -- ${mapped[@]+"${mapped[@]}"}
    ;;
  claude|grok|kimi)
    # Claude/grok: --resume / -r. Kimi Code: --session / -S (and --resume / -r
    # as hidden aliases). Bare `resume <id>` is rewritten to --resume.
    mapped=()
    while (( $# )); do
      case "$1" in
        resume)
          shift
          mapped+=(--resume)
          if (( $# )) && [[ "$1" != -* ]]; then
            mapped+=("$1"); shift
          fi ;;
        *)
          mapped+=("$1"); shift ;;
      esac
    done
    set -- ${mapped[@]+"${mapped[@]}"}
    ;;
esac
unset agent_base mapped uuid_re

# --- Hand off --------------------------------------------------------------
# Everything after the harness name is the agent's argv (e.g. grok --resume UUID,
# codex resume UUID, claude --resume UUID, kimi --session ID). Only launcher
# flags are stripped.
[[ -n "$bin_dir" ]] && export PATH="${bin_dir}:$PATH"
exec "${cmd[@]}" ${1+"$@"}
